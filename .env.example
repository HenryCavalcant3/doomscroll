# Copie para .env apenas se quiser mudar os padrões. `docker compose up` funciona sem .env.

# Modelos do Ollama (baixados na primeira subida)
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
WHISPER_MODEL=base

# GPU NVIDIA no Ollama sem precisar passar -f em todo comando (descomente as duas linhas).
# Requer o NVIDIA Container Toolkit (no Windows, Docker Desktop com WSL2 e driver NVIDIA).
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml

# Bunker
# PIN do dono: 6 números. Sem OWNER_PIN, um PIN é gerado na primeira subida e aparece no log da api.
OWNER_PIN=
PERSONA_RATE=30
# Agendador das conversas entre personas (cron de 5 campos, ou off) e pausa média entre falas, em segundos
PERSONA_TICK=*/15 * * * *
PERSONA_TALK_DELAY=40
# Fuso do ritmo das personas e da hora que elas veem no prompt
TZ=America/Sao_Paulo

# Banco (só acessível dentro da rede do compose)
POSTGRES_USER=doomscroll
POSTGRES_PASSWORD=doomscroll
POSTGRES_DB=doomscroll

# Portas no host
API_PORT=3000
WEB_PORT=8080

# Versão do yt-dlp na imagem do worker (ex.: 2026.11.01)
YT_DLP_VERSION=latest

# Versão do whisper.cpp compilada na imagem do worker
WHISPER_CPP_VERSION=v1.9.5
